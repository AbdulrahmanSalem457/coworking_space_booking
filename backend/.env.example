DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# The timezone the coworking space physically operates in. Booking times are
# stored as wall-clock values, so check-in gating depends on getting this right.
TIME_ZONE=Africa/Cairo

# Used once by `python manage.py ensure_admin` to create your superuser.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
