DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to accept browser requests from ANY origin — the API is meant to
# be usable from anyone's project. Set a comma-separated list to restrict it:
#   CORS_ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
CORS_ALLOWED_ORIGINS=

# The timezone the coworking space physically operates in. Booking times are
# stored as wall-clock values, so check-in gating depends on getting this right.
TIME_ZONE=Africa/Cairo

# Used once by `python manage.py ensure_admin` to create your superuser.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
